# Copy this file to .env.local and fill in as needed.
# Next.js loads .env.local automatically; NEXT_PUBLIC_ prefixed vars are
# exposed to the browser bundle, which api.ts / connect.ts / postInvoice.ts
# all require since they run client-side.

# Base URL for the primary Scantrix/Savetrix REST API (auth, invoices,
# vendors, QuickBooks connection metadata). Ported from the hardcoded
# BASE_URL in src/services/api.ts on the Scantrix_v2 frontend-ui-v2 branch.
NEXT_PUBLIC_API_URL=https://api.savetrix.com/api

# Base URL for the QuickBooks-specific backend used by the OAuth connect
# redirect and bill-posting calls. Ported from the hardcoded URLs in
# src/services/quickbooksService.ts and src/services/quickbooks/postInvoice.ts.
#
# NOTE: on the source branch this is a DIFFERENT host than NEXT_PUBLIC_API_URL
# above (a raw Cloud Run URL vs. the api.savetrix.com custom domain) — ported
# as-is, not assumed to be the same service. Confirm with the backend team
# whether this should actually point at NEXT_PUBLIC_API_URL's host instead.
NEXT_PUBLIC_QUICKBOOKS_API_URL=https://scantrix-api-4bvpc76k6q-uc.a.run.app


# Google OAuth Web client ID (Google Cloud Console → APIs & Services →
# Credentials → OAuth 2.0 Client IDs, "Web application" type). Required for
# GoogleSignInButton — without it, the button renders as a disabled
# "Coming Soon" state. See ASSUMPTIONS.md (A7) for the "Authorized
# JavaScript origins" caveat.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Apple Services ID (Apple Developer → Certificates, Identifiers & Profiles →
# Identifiers → Services IDs, with "Sign in with Apple" enabled), used by
# AppleSignInButton. Without it, the button renders as a disabled "Coming
# Soon" state — same as Google/Microsoft above.
#
# NOTE: no Apple Developer account/Services ID exists for this project yet.
# Setting this alone is not enough; the exact redirect URI below must also
# be registered as a Return URL against this Services ID in Apple
# Developer, or sign-in will fail even with both set.
NEXT_PUBLIC_APPLE_CLIENT_ID=

# The web Return URL registered against the Services ID above. Must match
# EXACTLY (including scheme/port) — Apple validates this even in the popup
# flow. Defaults to the page's own origin (window.location.origin) if unset,
# which is enough for most setups; only set this if Apple Developer requires
# a different registered URL (e.g. a dedicated callback path).
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# Azure AD app registration client ID (Azure Portal → App registrations →
# your app → Overview → "Application (client) ID"), used by
# MicrosoftSignInButton for "Sign in with Microsoft/Outlook" via
# @azure/msal-browser. Without it, the button renders as a disabled
# "Coming Soon" state — same as Google above.
#
# NOTE: the backend has no /auth/microsoft endpoint yet (see the NOTE above
# microsoftLogin in src/store/auth/authApi.ts for the exact contract it
# needs to implement) — setting this client ID alone is not enough to make
# the button functional end-to-end.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# Optional. Defaults to "common" (accepts both Azure AD work/school accounts
# and personal Outlook.com/Hotmail accounts) if unset — only set this to
# restrict sign-in to a single Azure AD tenant.
NEXT_PUBLIC_MICROSOFT_TENANT_ID=

# URL of the Scantrix MCP server, shown in the Claude MCP setup guide on the
# Integrations page (AccountingSoftwaresContent.tsx). Defaults to the live
# production server (https://mcp.scantrix.ai/mcp) in code if unset — only set
# this to point the setup guide at a different environment (e.g. staging).
NEXT_PUBLIC_MCP_SERVER_URL=

# ── Chatbot (src/app/api/chat/route.ts) ──────────────────────────────────
# Server secret for the in-app AI chat assistant. Deliberately NOT prefixed
# NEXT_PUBLIC_ — that prefix ships a value into the browser bundle, and this
# is the first real secret this repo holds. Only ever read inside
# src/app/api/chat/route.ts (a server-only file). Set the real value in
# Vercel's project environment variables, never here / never commit it.
OPENAI_API_KEY=

# Optional. Model used for chat completions — pick deliberately for the
# quality/cost tradeoff (see architecture doc §9); defaults to a
# cost-effective model in src/lib/chatbot/systemPrompt.ts if unset.
OPENAI_MODEL=gpt-5.4-mini

# ── Chat history (src/lib/chatHistory/, /api/chat/history) ────────────────
# Chat history is stored server-side, one JSON document per user, in a
# PRIVATE Vercel Blob store — the first datastore this project has. It has to
# be server-side: "a user sees only their own conversations" cannot be
# enforced in the browser, and history has to survive a new device.
#
# The store already exists for this project (scantrix-chat-history, private,
# iad1) and is connected to it, so Vercel injects the credentials into
# Production/Preview/Development automatically — there is nothing to set in
# the dashboard by hand.
#
# For local development, DON'T copy a token in here by hand. Run:
#
#   vercel link            # once, if .vercel/project.json is missing
#   vercel env pull        # writes BLOB_READ_WRITE_TOKEN into .env.local
#
# To stand the store up again from scratch (new Vercel project, or after it
# was deleted), one command creates it and wires all three environments:
#
#   vercel blob create-store scantrix-chat-history --access private --yes \
#     --environment production --environment preview --environment development
#
# Without these credentials the chat panel still chats; the history list and
# saving degrade to a "temporarily unavailable" state rather than failing the
# conversation (src/lib/chatHistory/store.ts).
BLOB_READ_WRITE_TOKEN=

# ── Invoice forwarding by email ────────────────────────────────────────────
# Full setup walkthrough: EMAIL_FORWARDING_DEPLOY.md
# Design and contracts:    EMAIL_INVOICE_INGESTION_ARCHITECTURE.md
#
# Server-only, every one of them. None may take a NEXT_PUBLIC_ prefix: a
# NEXT_PUBLIC_ variable is inlined into the browser bundle, which would publish
# the webhook signing secret, the provider API key, and the key that decrypts
# stored refresh tokens.

# Master switch. While false the webhook still verifies signatures and RECORDS
# every message, but creates no invoices — and because those records are left in
# a non-terminal state, replaying the deliveries after you flip this to true
# imports them rather than skipping them. Nothing queued is lost.
INBOUND_EMAIL_ENABLED=false

# Only "resend" has an adapter today.
INBOUND_EMAIL_PROVIDER=resend

# Receiving domain. Two supported shapes:
#   <id>.resend.app     — Resend-managed, needs NO DNS records at all. Use this
#                         to test today.
#   invoice.scantrix.ai — production. Needs one MX record on the SUBDOMAIN, at
#                         the lowest priority. scantrix.ai's own records are
#                         untouched, so existing mail cannot break.
# Moving between them is this variable plus the MX record — no code change.
INBOUND_EMAIL_DOMAIN=

# Resend API key. Needs read access to received emails and their attachments.
INBOUND_PROVIDER_API_KEY=

# Signing secret for the receiving webhook (Resend shows it when you create the
# webhook). Verified over the RAW request body before anything is parsed.
INBOUND_WEBHOOK_SIGNING_SECRET=

# Replay window, seconds. A timestamp further away than this in EITHER direction
# is refused — a future-dated one is as suspicious as a stale one.
INBOUND_WEBHOOK_TOLERANCE_SECONDS=300

# Encrypts the delegated refresh token at rest (AES-256-GCM). REQUIRED — the
# routes refuse to create an address without it.
#   openssl rand -base64 32
# Rotating this makes every stored delegation unopenable; users then have to hit
# "Reconnect" on each address. That is the safe failure direction — nothing
# leaks, forwarding just stops until they do.
INBOUND_TOKEN_ENCRYPTION_KEY=

# Reject a message when no SPF/DKIM/DMARC verdict can be established.
#
# Defaults to FALSE, deliberately — the original design defaulted it to true,
# before we confirmed that Resend's inbound webhook carries NO authentication
# results at all. Verdicts are parsed out of the `Authentication-Results` header
# instead, and if that header does not arrive, `true` would reject every single
# message as authentication_failed and the feature would look broken.
#
# Forward one invoice, read the "Sender authentication details" block in the
# company's Email forwarding panel, then set this to true.
INBOUND_REQUIRE_EMAIL_AUTH=false

# Pin the provider's authserv-id — the server name at the start of the
# `Authentication-Results` header. Until this is set, the parsed verdicts are
# reported as "advisory", because a forwarded message carries the ORIGINAL
# sender's headers too and nothing proves which one we are reading. With it set,
# only a header bearing this id is believed. Copy the "Reported by" value from
# the diagnostics block.
INBOUND_EXPECTED_AUTHSERV_ID=

# Envelope caps. Tighter than manual upload on purpose: a signed-in user
# pressing Upload has already authenticated, whereas inbound mail is
# unauthenticated until the sender check passes, and the sender picks the payload.
INBOUND_MAX_ATTACHMENTS=10
INBOUND_MAX_FILE_BYTES=15728640
INBOUND_MAX_TOTAL_BYTES=41943040

# How long inbound message records are kept (see store.pruneMessages). Metadata
# only — no email bodies and no attachment bytes are ever stored.
INBOUND_RETENTION_DAYS=30

# Comma-separated host allow-list for attachment downloads. Leave blank unless
# Resend changes its CDN host; the default already covers it. This is an SSRF
# boundary — widening it to a host you do not control lets the provider point
# our fetcher anywhere.
INBOUND_DOWNLOAD_HOST_ALLOWLIST=

# Reject a message the provider's own scanner flagged as spam. OFF by default:
# an invoice forwarded from a noisy mailbox trips spam heuristics easily, and
# silently discarding a real invoice is worse than importing a junk one that a
# human rejects at review. Virus verdicts are ALWAYS enforced regardless.
INBOUND_REJECT_SPAM=false

# Reject when no virus verdict is available at all. OFF by default so a provider
# that stops sending the header, or a future non-SES provider, does not reject
# every invoice. Turn on once you have confirmed the header arrives.
INBOUND_REQUIRE_VIRUS_VERDICT=false

# The dedicated Scantrix account that performs every inbound upload. It is
# invited as a Contributor to each forwarding-enabled company. NO HUMAN MAY EVER
# SIGN IN TO IT — the backend allows one live session per account, so a human
# login would kill the server's session and stop forwarding until it recovers.
INBOUND_SERVICE_EMAIL=
INBOUND_SERVICE_PASSWORD=

# ── Custom Plan enquiries ("Talk to Sales") ────────────────────────────────
# Powers the Custom card on both pricing surfaces: the in-app /plans page and
# the public pricing section on the landing page. The endpoint is
# POST /api/custom-plan-enquiry (src/app/api/custom-plan-enquiry/route.ts).
#
# Server-only, all three. None may take a NEXT_PUBLIC_ prefix — that would
# inline the provider key into the browser bundle, and put the sales inbox in
# front of every scraper that reads the page source.

# Where enquiries are delivered.
#
# Optional. Defaults to support@scantrix.ai — the address the app already
# publishes in the profile screen, so the form works on a fresh deployment
# rather than failing closed. Point this at a dedicated sales inbox when one
# exists; sales enquiries land in the support queue until you do.
CUSTOM_PLAN_ENQUIRY_TO_EMAIL=

# The From address on the notification. REQUIRED — there is no fallback,
# because guessing it means guessing which domain is verified for sending, and
# a wrong guess fails at the provider with a 403 that reads like an outage.
#
# Accepts "a@b.com" or "Scantrix <a@b.com>". The domain MUST be verified for
# SENDING in the Resend dashboard: verifying a domain for RECEIVING (the MX
# record in EMAIL_FORWARDING_DEPLOY.md) is a separate record and a separate
# verification, and does not authorize sending from it. Use a no-reply address
# on a domain you control — the visitor's own address goes in Reply-To, so
# hitting Reply in the sales inbox still reaches them.
#
# Confirmed against the live Resend account on 2026-09-02: invoice.scantrix.ai
# is verified for BOTH directions — DKIM (resend._domainkey.invoice) and SPF
# (send.invoice) for sending, plus the receiving MX. So
#   Scantrix <no-reply@invoice.scantrix.ai>
# works today with no further DNS work. A test enquiry sent through this
# endpoint reached support@scantrix.ai with last_event=delivered.
CUSTOM_PLAN_ENQUIRY_FROM_EMAIL=

# Resend API key used for SENDING. Needs send permission.
#
# Optional. Falls back to INBOUND_PROVIDER_API_KEY above, because on most
# deployments both are the same Resend account and one full-access key covers
# both directions. Set this separately if your inbound key is read-scoped, so
# sending gets its own credential without weakening the inbound one.
OUTBOUND_EMAIL_API_KEY=
